# Environment
.env
# frontend/.env holds no secrets (just the app version for the
# footer) -- track it like any other source file.
!frontend/.env

# Node / frontend
node_modules/
dist/

# Python / backend
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
*.log

# Uploaded user files (bind-mounted storage, dev default location)
storage-data/
