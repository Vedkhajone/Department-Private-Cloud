# Copy this file to .env and adjust values as needed.
# Do not commit the real .env file.

POSTGRES_DB=decp
POSTGRES_USER=decp_user
POSTGRES_PASSWORD=change_me

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

SERVICE_NAME=decp-backend
ENVIRONMENT=development

# JWT / authentication configuration.
# JWT_SECRET has no default -- generate a real random value for any
# environment beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_to_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage configuration.
#
# STORAGE_HOST_PATH is a path on the HOST machine (this PC, or the
# department server later) where uploaded files are actually kept.
# Docker Compose mounts it into the backend container at STORAGE_ROOT.
# Change STORAGE_HOST_PATH when deploying so files live somewhere
# durable on the department server (e.g. /cloud-data).
STORAGE_HOST_PATH=./storage-data
STORAGE_ROOT=/cloud-data

# Default per-user storage quota, in bytes. 10737418240 = 10 GiB.
DEFAULT_STORAGE_QUOTA_BYTES=10737418240
